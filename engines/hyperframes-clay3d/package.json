{
  "name": "@stickman-video-director/hyperframes-clay3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-only Apache-2.0 HyperFrames integration with a procedural Three.js clay character engine.",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "doctor": "node scripts/hf.mjs doctor --json",
    "check": "node scripts/hf.mjs check --json",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/hf.mjs preview --foreground --port 4317",
    "render": "node scripts/render.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "hyperframes": "0.9.88",
    "three": "0.187.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "puppeteer-core": "25.18.1"
  }
}
